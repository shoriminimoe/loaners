# Supabase project URL and publishable (or legacy anon) key.
# Local values come from `npx supabase status`; production values from the
# Supabase dashboard (Project Settings → API Keys). Never put the secret or
# service role key here: the app does not need it.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
